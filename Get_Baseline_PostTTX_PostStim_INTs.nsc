%M1 stim
doc = GetActiveDocument()
doc.Baseline = NewIntEvent(doc, 0)
AddInterval(doc.Baseline, 0, 180)
doc.Poststim = NewIntEvent(doc, 0)
AddInterval(doc.Poststim, 603, 783)

%M1 ttx
doc = GetActiveDocument()
