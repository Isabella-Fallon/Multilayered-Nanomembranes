doc = GetActiveDocument()

%300-3000hz (spiking band, filtered from raw 30kHz)
FilterContinuousVariable(doc, doc["raw 1"], "raw 1_bandpass300-3000hz", "Bandpass", 4, 300, 3000)
FilterContinuousVariable(doc, doc["raw 2"], "raw 2_bandpass300-3000hz", "Bandpass", 4, 300, 3000)
FilterContinuousVariable(doc, doc["raw 3"], "raw 3_bandpass300-3000hz", "Bandpass", 4, 300, 3000)
FilterContinuousVariable(doc, doc["raw 4"], "raw 4_bandpass300-3000hz", "Bandpass", 4, 300, 3000)
FilterContinuousVariable(doc, doc["raw 5"], "raw 5_bandpass300-3000hz", "Bandpass", 4, 300, 3000)
FilterContinuousVariable(doc, doc["raw 6"], "raw 6_bandpass300-3000hz", "Bandpass", 4, 300, 3000)
FilterContinuousVariable(doc, doc["raw 7"], "raw 7_bandpass300-3000hz", "Bandpass", 4, 300, 3000)
FilterContinuousVariable(doc, doc["raw 8"], "raw 8_bandpass300-3000hz", "Bandpass", 4, 300, 3000)
FilterContinuousVariable(doc, doc["raw 9"], "raw 9_bandpass300-3000hz", "Bandpass", 4, 300, 3000)
FilterContinuousVariable(doc, doc["raw 10"], "raw 10_bandpass300-3000hz", "Bandpass", 4, 300, 3000)
FilterContinuousVariable(doc, doc["raw 11"], "raw 11_bandpass300-3000hz", "Bandpass", 4, 300, 3000)

doc = GetActiveDocument()
%anti-alias lowpass at 500hz before decimating  
FilterContinuousVariable(doc, doc["raw 1"], "raw 1_lp500", "Lowpass", 4, 500, 0)
FilterContinuousVariable(doc, doc["raw 2"], "raw 2_lp500", "Lowpass", 4, 500, 0)
FilterContinuousVariable(doc, doc["raw 3"], "raw 3_lp500", "Lowpass", 4, 500, 0)
FilterContinuousVariable(doc, doc["raw 4"], "raw 4_lp500", "Lowpass", 4, 500, 0)
FilterContinuousVariable(doc, doc["raw 5"], "raw 5_lp500", "Lowpass", 4, 500, 0)
FilterContinuousVariable(doc, doc["raw 6"], "raw 6_lp500", "Lowpass", 4, 500, 0)
FilterContinuousVariable(doc, doc["raw 7"], "raw 7_lp500", "Lowpass", 4, 500, 0)
FilterContinuousVariable(doc, doc["raw 8"], "raw 8_lp500", "Lowpass", 4, 500, 0)
FilterContinuousVariable(doc, doc["raw 9"], "raw 9_lp500", "Lowpass", 4, 500, 0)
FilterContinuousVariable(doc, doc["raw 10"], "raw 10_lp500", "Lowpass", 4, 500, 0)
FilterContinuousVariable(doc, doc["raw 11"], "raw 11_lp500", "Lowpass", 4, 500, 0)

doc = GetActiveDocument()
%decimate lowpassed signal to 1500hz sampling rate (30kHz / 20)
DecimateContVar(doc, "raw 1_decc", doc["raw 1_lp500"], 20)
DecimateContVar(doc, "raw 2_decc", doc["raw 2_lp500"], 20)
DecimateContVar(doc, "raw 3_decc", doc["raw 3_lp500"], 20)
DecimateContVar(doc, "raw 4_decc", doc["raw 4_lp500"], 20)
DecimateContVar(doc, "raw 5_decc", doc["raw 5_lp500"], 20)
DecimateContVar(doc, "raw 6_decc", doc["raw 6_lp500"], 20)
DecimateContVar(doc, "raw 7_decc", doc["raw 7_lp500"], 20)
DecimateContVar(doc, "raw 8_decc", doc["raw 8_lp500"], 20)
DecimateContVar(doc, "raw 9_decc", doc["raw 9_lp500"], 20)
DecimateContVar(doc, "raw 10_decc", doc["raw 10_lp500"], 20)
DecimateContVar(doc, "raw 11_decc", doc["raw 11_lp500"], 20)

